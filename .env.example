# ── Database ──────────────────────────────────────────────────────────────────
# Local: the URL `supabase status` prints (127.0.0.1:54322). Hosted: the
# *session pooler* URI from the dashboard (aws-0-<region>.pooler.supabase.com:5432,
# user postgres.<ref>); the direct db.<ref> host is IPv6-only.
DATABASE_URL="postgres://user:password@host:port/db-name"
# Connections each server process may hold. Unset: 5 in dev, 10 in production.
# DB_POOL_MAX=10   (default: 10 locally, 2 through Supabase's pooler, which caps the project at 15)

# Moderators: auth user ids, comma-separated. Unset or empty: nobody.
# MODERATOR_IDS=

# ── Supabase ──────────────────────────────────────────────────────────────────
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SECRET_KEY="your-service-role-key"
# Project ref (the subdomain of PUBLIC_SUPABASE_URL). Every `:prod` script
# (db:migrate:prod, db:seed:prod, db:sql:prod) refuses to run unless both
# URLs above name this project.
SUPABASE_PROJECT_ID="your-project-ref"

# ── Seeding ───────────────────────────────────────────────────────────────────
# The user `pnpm db:seed` (re)creates; only this one auth user is replaced.
# Defaults to spencer@fork.dev and "Fork-Demo-2025!" if not set.
SEED_USER_EMAIL="spencer@fork.dev"
SEED_USER_PASSWORD="Fork-Demo-2025!"
# The seed's second user (devcooks, spencerfletcher's friend), with the same
# password. Defaults to dev@fork.dev; .env.e2e sets its own so the suites'
# auth users never collide, since auth is shared with the dev database.
SEED_USER2_EMAIL="dev@fork.dev"
# The third (priyabakes, who has sent spencerfletcher a friend request), same
# password; .env.e2e sets its own for the same reason.
SEED_USER3_EMAIL="priya@fork.dev"

# ── E2E tests ─────────────────────────────────────────────────────────────────
# `pnpm test:e2e` takes the local stack's URL and keys from .env.local and lays
# the committed .env.e2e over it: the fork_e2e database and its own seed user
# (e2e@fork.local, with E2E_USER_EMAIL / E2E_USER_PASSWORD to sign in as it).
# .env.e2e holds no keys, so nothing secret-looking is ever committed.
