# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgres://user:password@host:port/db-name"

# ── Supabase ──────────────────────────────────────────────────────────────────
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SECRET_KEY="your-service-role-key"
# Project ref (the subdomain of PUBLIC_SUPABASE_URL). Used by `pnpm db:types`.
SUPABASE_PROJECT_ID="your-project-ref"

# ── Seeding ───────────────────────────────────────────────────────────────────
# Password used when `pnpm db:seed` creates the demo user (spencer@fork.dev).
# Defaults to "Fork-Demo-2025!" if not set.
SEED_USER_PASSWORD="Fork-Demo-2025!"

# ── Spoonacular (ingredient gram conversion) ──────────────────────────────────
# Optional. If set, used as fallback for ingredients not in the local density table.
# Free tier: 150 requests/day. https://spoonacular.com/food-api
SPOONACULAR_API_KEY=""

# ── E2E tests (authenticated flows) ───────────────────────────────────────────
# Must match the seeded user. Without these, authenticated e2e tests are skipped.
E2E_USER_EMAIL="spencer@fork.dev"
E2E_USER_PASSWORD="Fork-Demo-2025!"
