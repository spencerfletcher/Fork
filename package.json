{
	"name": "fork",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"// ── Dev ───────────────────────────────────────────────────────": "",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"// ── Code Quality ────────────────────────────────────────────": "",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"verify": "pnpm check && pnpm lint && pnpm test:unit run && pnpm build",
		"// ── Testing ─────────────────────────────────────────────────": "",
		"test": "pnpm test:unit run && pnpm test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"// ── Database ─────────────────────────────────────────────────": "",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/db-migrate.ts",
		"db:migrate:e2e": "DB_TARGET=e2e tsx scripts/db-migrate.ts",
		"db:migrate:prod": "DB_TARGET=prod tsx scripts/db-migrate.ts",
		"db:sql": "tsx scripts/db-sql.ts",
		"db:sql:prod": "DB_TARGET=prod tsx scripts/db-sql.ts",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"db:seed:e2e": "DB_TARGET=e2e tsx src/lib/server/db/seed.ts",
		"db:seed:prod": "DB_TARGET=prod tsx src/lib/server/db/seed.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.19.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@fontsource/bitter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/source-sans-3": "^5.3.1",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.4",
		"parse-ingredient": "3.0.0",
		"postgres": "^3.4.9",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
