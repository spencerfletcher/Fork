# The e2e suite's own database on the local Supabase stack, reset to the seed
# before every `pnpm test:e2e` (e2e/global-setup.ts). Committed, so it holds no
# keys: the stack's URL and keys come from .env.local (CI exports them), and
# these lines override it. Auth is shared with the dev database, so the suite
# signs in as its own user.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/fork_e2e"

SEED_USER_EMAIL="e2e@fork.local"
SEED_USER_PASSWORD="Fork-E2E-2026!"
E2E_USER_EMAIL="e2e@fork.local"
E2E_USER_PASSWORD="Fork-E2E-2026!"
